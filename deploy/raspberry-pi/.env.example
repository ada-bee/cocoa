# Repository name assigned when the Nix-built image is loaded or published.
COCOA_GATEWAY_IMAGE_REPOSITORY=cocoa-gateway

# Required by compose.yaml. Use the immutable sha256 digest, never a tag.
COCOA_GATEWAY_IMAGE_DIGEST=sha256:replace-with-loaded-or-published-image-digest

# `git:<revision>` reported by /healthz and /readyz for this image build.
COCOA_EXPECTED_BUILD_IDENTITY=git:replace-with-source-revision
