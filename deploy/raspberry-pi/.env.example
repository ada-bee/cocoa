# Required by compose.yaml. Use a locally loaded sha256 image ID or a published
# repository@sha256 manifest digest, never a mutable tag.
COCOA_GATEWAY_IMAGE_REFERENCE=sha256:replace-with-local-image-id-or-published-manifest-digest

# `git:<revision>` reported by /healthz and /readyz for this image build.
COCOA_EXPECTED_BUILD_IDENTITY=git:replace-with-source-revision
